class Solution {
    public int removeDuplicates(int[] nums) {
        int k = 1;
        int l = nums.length;
        int temp = nums[0];
        int arr [] = new int[l];
        arr[0] = temp;
        for (int i = 1; i < l; i++) {
            if(temp == nums[i]){
                temp = nums[i];
            }
            else {
                arr[k] = nums[i];
                k++;
                temp = nums[i];
            }
        }
        for (int i = 0; i < l; i++) {
            nums[i] = arr[i];
        }
        return k;
    }
}
